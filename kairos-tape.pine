// Kairos Tape v6 - overlay. Pair with Kairos Wave (separate pane). Do not merge.
// Long-only. Wave regular bear-div (price HH + blend LH) prints INV and kills K / STLong / SUPERLONG / IN.
//@version=6
indicator("Kairos Tape", shorttitle = "KRS Tape", overlay = true, max_labels_count = 500, max_lines_count = 50)

color cTeal   = #3aa88a
color cRose   = #c45c4a
color cCopper = #c9a227
color cSlate  = #8aa0b4
color cInk    = #d8d4c8
// Directional rainbow: cool spectrum when stacked up, warm when stacked down.
color cFastUp = #00f5d4
color cFastDn = #ff2d6a
color cMidUp  = #57cc99
color cMidDn  = #ff7a3a
color cSlowUp = #4ea8de
color cSlowDn = #9b5de5

string profile = input.string("Intraday", "Profile", options = ["Scalp", "Intraday", "Swing", "Custom"], group = "0. Profile")
bool confirmOnClose = input.bool(true, "Confirm on bar close", group = "0. Profile")
bool showDash = input.bool(true, "Show dashboard", group = "0. Profile")

int in1 = input.int(14, "Len 1", minval = 1, group = "1. Ribbon", inline = "L")
int in2 = input.int(21, "Len 2", minval = 1, group = "1. Ribbon", inline = "L")
int in3 = input.int(34, "Len 3", minval = 1, group = "1. Ribbon", inline = "M")
int in4 = input.int(50, "Len 4", minval = 1, group = "1. Ribbon", inline = "M")
int in5 = input.int(100, "Len 5", minval = 1, group = "1. Ribbon", inline = "S")
int in6 = input.int(170, "Len 6", minval = 1, group = "1. Ribbon", inline = "S")
string maType = input.string("EMA", "Method", options = ["EMA", "SMA", "RMA", "WMA", "VWMA", "HMA"], group = "1. Ribbon")
bool showClouds = input.bool(true, "Clouds", group = "1. Ribbon")
bool showLines  = input.bool(false, "MA lines", group = "1. Ribbon")
bool showSlow   = input.bool(true, "Show slow MA", group = "1. Ribbon")

int len1 = profile == "Scalp" ? 8  : profile == "Swing" ? 21  : profile == "Custom" ? in1 : 14
int len2 = profile == "Scalp" ? 13 : profile == "Swing" ? 34  : profile == "Custom" ? in2 : 21
int len3 = profile == "Scalp" ? 21 : profile == "Swing" ? 55  : profile == "Custom" ? in3 : 34
int len4 = profile == "Scalp" ? 34 : profile == "Swing" ? 89  : profile == "Custom" ? in4 : 50
int len5 = profile == "Scalp" ? 55 : profile == "Swing" ? 144 : profile == "Custom" ? in5 : 100
int len6 = profile == "Scalp" ? 89 : profile == "Swing" ? 233 : profile == "Custom" ? in6 : 170

f_ma(float src, int length, string typ) =>
    switch typ
        "SMA"  => ta.sma(src, length)
        "RMA"  => ta.rma(src, length)
        "WMA"  => ta.wma(src, length)
        "VWMA" => ta.vwma(src, length)
        "HMA"  => ta.hma(src, length)
        => ta.ema(src, length)

float MA1 = f_ma(close, len1, maType)
float MA2 = f_ma(close, len2, maType)
float MA3 = f_ma(close, len3, maType)
float MA4 = f_ma(close, len4, maType)
float MA5 = f_ma(close, len5, maType)
float MA6 = f_ma(close, len6, maType)

bool showST = input.bool(false, "Show SuperTrend", group = "2. SuperTrend")
float f1 = input.float(1.0, "Factor 1", minval = 0.1, step = 0.1, group = "2. SuperTrend", inline = "st")
float f2 = input.float(2.0, "Factor 2", minval = 0.1, step = 0.1, group = "2. SuperTrend", inline = "st")
float f3 = input.float(3.0, "Factor 3", minval = 0.1, step = 0.1, group = "2. SuperTrend", inline = "st")
int p1 = input.int(10, "ATR 1", minval = 1, group = "2. SuperTrend", inline = "ap")
int p2 = input.int(11, "ATR 2", minval = 1, group = "2. SuperTrend", inline = "ap")
int p3 = input.int(12, "ATR 3", minval = 1, group = "2. SuperTrend", inline = "ap")

[st1, dir1] = ta.supertrend(f1, p1)
[st2, dir2] = ta.supertrend(f2, p2)
[st3, dir3] = ta.supertrend(f3, p3)
int stBullCount = (dir1 < 0 ? 1 : 0) + (dir2 < 0 ? 1 : 0) + (dir3 < 0 ? 1 : 0)
bool stMajorityUp = stBullCount >= 2
bool stMajorityDn = stBullCount <= 1
bool stFlipUp = dir3 < 0 and dir3[1] >= 0
bool stFlipDn = dir3 > 0 and dir3[1] <= 0

bool showLarge = input.bool(true, "Large swings", group = "3. Structure", inline = "lg")
int lgLeft = input.int(24, "L", minval = 2, group = "3. Structure", inline = "lg")
int lgRight = input.int(24, "", minval = 2, group = "3. Structure", inline = "lg")
bool showMedium = input.bool(true, "Medium swings", group = "3. Structure", inline = "md")
int mdLeft = input.int(8, "M", minval = 2, group = "3. Structure", inline = "md")
int mdRight = input.int(8, "", minval = 2, group = "3. Structure", inline = "md")

float lgHi = ta.pivothigh(high, lgLeft, lgRight)
float lgLo = ta.pivotlow(low, lgLeft, lgRight)
float mdHi = ta.pivothigh(high, mdLeft, mdRight)
float mdLo = ta.pivotlow(low, mdLeft, mdRight)

if showLarge and not na(lgHi)
    label.new(bar_index - lgRight, lgHi, "", xloc = xloc.bar_index, color = cRose, style = label.style_circle, size = size.small)
if showLarge and not na(lgLo)
    label.new(bar_index - lgRight, lgLo, "", xloc = xloc.bar_index, color = cRose, style = label.style_circle, size = size.small)
if showMedium and not na(mdHi)
    label.new(bar_index - mdRight, mdHi, "", xloc = xloc.bar_index, color = cTeal, style = label.style_circle, size = size.tiny)
if showMedium and not na(mdLo)
    label.new(bar_index - mdRight, mdLo, "", xloc = xloc.bar_index, color = cTeal, style = label.style_circle, size = size.tiny)

bool largeSwing = showLarge and (not na(lgHi) or not na(lgLo))

int hmaFastLen = input.int(6, "HMA fast", minval = 1, group = "4. Internals")
int hmaSlowLen = input.int(12, "HMA slow", minval = 1, group = "4. Internals")
float hullFast = ta.hma(close, hmaFastLen)
float hullSlow = ta.hma(close, hmaSlowLen)

int cciLen = input.int(50, "CCI length", minval = 1, group = "4. Internals")
float cci = ta.cci(ohlc4, cciLen)
int cciSoft = input.int(10, "CCI tint", group = "4. Internals")
int cciExt = input.int(166, "CCI exhaustion", group = "4. Internals")

int macdFast = input.int(12, "MACD fast", minval = 1, group = "4. Internals", inline = "m")
int macdSlow = input.int(20, "MACD slow", minval = 1, group = "4. Internals", inline = "m")
int macdSig = input.int(9, "MACD sig", minval = 1, group = "4. Internals", inline = "m")
float macd = ta.ema(close, macdFast) - ta.ema(close, macdSlow)
float macdSignal = ta.ema(macd, macdSig)
float macdPct = close != 0 ? (macd / close) * 100.0 : 0.0

f_tema(float src, int len) =>
    e1 = ta.ema(src, len)
    e2 = ta.ema(e1, len)
    e3 = ta.ema(e2, len)
    3.0 * e1 - 3.0 * e2 + e3

float tema1 = f_tema(close, 25)
float tema2 = f_tema(close, 34)
float tema3 = f_tema(close, 50)
float tema4 = f_tema(close, 100)

float hull2 = ta.hma(close, 2)
float hull80 = ta.hma(close, 80)

float esa = ta.ema(hlc3, 10)
float dAbs = ta.ema(math.abs(hlc3 - esa), 10)
float ci = dAbs == 0 ? 0.0 : (hlc3 - esa) / (0.015 * dAbs)
float wt1 = ta.ema(ci, 21)
float wt2 = ta.sma(wt1, 4)

int erLen = input.int(20, "ER lookback", minval = 5, group = "5. Regime")
float erDen = math.sum(math.abs(close - close[1]), erLen)
float er = erDen == 0 ? 1.0 : math.abs(close - close[erLen]) / erDen
[_diPlus, _diMinus, adxVal] = ta.dmi(14, 14)
int chopLen = input.int(14, "CHOP length", minval = 2, group = "5. Regime")
float chopRange = ta.highest(high, chopLen) - ta.lowest(low, chopLen)
float chop = chopRange == 0 ? 50.0 : 100.0 * math.log10(math.sum(ta.atr(1), chopLen) / chopRange) / math.log10(chopLen)
float erTrend = input.float(0.30, "ER trend >=", minval = 0.05, step = 0.05, group = "5. Regime")
float adxTrend = input.float(20.0, "ADX trend >=", minval = 5, group = "5. Regime")
float chopTrend = input.float(61.8, "CHOP range >=", minval = 30, group = "5. Regime")
bool blockChop = input.bool(true, "Suppress impulse in CHOP", group = "5. Regime")
bool isChop = chop >= chopTrend or (er < 0.20 and adxVal < 18)
bool isTrend = er >= erTrend and adxVal >= adxTrend and chop < chopTrend
string regime = isChop ? "CHOP" : isTrend ? "TREND" : "TRANSITION"

int volLen = input.int(20, "Rel volume SMA", minval = 1, group = "6. Volume")
float volMult = input.float(1.0, "Min rel volume", minval = 0.0, step = 0.1, group = "6. Volume")
bool requireVol = input.bool(true, "Require volume for impulse", group = "6. Volume")
bool showVwap = input.bool(false, "Show VWAP", group = "6. Volume")
float relVol = ta.sma(volume, volLen) == 0 ? 1.0 : volume / ta.sma(volume, volLen)
bool volOk = relVol >= volMult
float vwapVal = ta.vwap(hlc3)

string htf = input.timeframe("", "HTF (blank = chart)", group = "7. HTF")
bool requireHtf = input.bool(true, "Require HTF agreement", group = "7. HTF")
float htfClose = request.security(syminfo.tickerid, htf, close[1], barmerge.gaps_off, barmerge.lookahead_on)
float htfEma50 = request.security(syminfo.tickerid, htf, ta.ema(close, 50)[1], barmerge.gaps_off, barmerge.lookahead_on)
float htfCci50 = request.security(syminfo.tickerid, htf, ta.cci(ohlc4, 50)[1], barmerge.gaps_off, barmerge.lookahead_on)
bool htfBull = htfClose > htfEma50 and htfCci50 > 0
bool htfBear = htfClose < htfEma50 and htfCci50 < 0
int htfVote = htfBull ? 1 : htfBear ? -1 : 0

int vFast = MA1 > MA2 ? 1 : MA1 < MA2 ? -1 : 0
int vMid  = MA3 > MA4 ? 1 : MA3 < MA4 ? -1 : 0
int vSlow = MA5 > MA6 ? 1 : MA5 < MA6 ? -1 : 0
int vPx   = close > MA6 ? 1 : close < MA6 ? -1 : 0
int vST   = stMajorityUp ? 1 : stMajorityDn ? -1 : 0
int vHma  = hullFast > hullSlow ? 1 : hullFast < hullSlow ? -1 : 0
int vCci  = cci > 0 ? 1 : cci < 0 ? -1 : 0
int vMacd = macd > macdSignal ? 1 : macd < macdSignal ? -1 : 0
int vTema = tema1 > tema2 and tema2 > tema3 ? 1 : tema1 < tema2 and tema2 < tema3 ? -1 : 0
int vWt   = wt1 > wt2 ? 1 : wt1 < wt2 ? -1 : 0
int score = vFast + vMid + vSlow + vPx + vST + vHma + vCci + vMacd + vTema + vWt

// Hidden Wave blend - must match the Wave pane preset or INV will not line up with BEAR.
string waveReplica = input.string("Research (CCI+WT)", "Wave blend replica", options = ["Research (CCI+WT)", "HYPE (RSI+CCI+Stoch+MFI)", "Full 5"], group = "11. Invalidation")
float wRsi = math.max(-200.0, math.min(200.0, ta.rsi(close, 14) * 4.0 - 200.0))
float wCci = math.max(-200.0, math.min(200.0, ta.cci(hlc3, 50)))
float wSto = math.max(-200.0, math.min(200.0, ta.sma(ta.stoch(close, high, low, 14), 3) * 4.0 - 200.0))
float esaW = ta.ema(hlc3, 9)
float deW = ta.ema(math.abs(hlc3 - esaW), 9)
float ciW = deW == 0 ? 0.0 : (hlc3 - esaW) / (0.015 * deW)
float wWt  = math.max(-200.0, math.min(200.0, ta.ema(ciW, 12) * 2.0))
float wMfi = math.max(-200.0, math.min(200.0, (ta.mfi(hlc3, 60) - 50.0) * 4.0))
bool rRsi = waveReplica != "Research (CCI+WT)"
bool rCci = true
bool rSto = waveReplica != "Research (CCI+WT)"
bool rWt  = waveReplica != "HYPE (RSI+CCI+Stoch+MFI)"
bool rMfi = waveReplica != "Research (CCI+WT)"
int wN = (rRsi and not na(wRsi) ? 1 : 0) + (rCci and not na(wCci) ? 1 : 0) + (rSto and not na(wSto) ? 1 : 0) + (rWt and not na(wWt) ? 1 : 0) + (rMfi and not na(wMfi) ? 1 : 0)
float wAcc = (rRsi and not na(wRsi) ? wRsi : 0.0) + (rCci and not na(wCci) ? wCci : 0.0) + (rSto and not na(wSto) ? wSto : 0.0) + (rWt and not na(wWt) ? wWt : 0.0) + (rMfi and not na(wMfi) ? wMfi : 0.0)
float waveBlend = wN == 0 ? 0.0 : wAcc / wN
float waveMA = ta.ema(waveBlend, 14)
bool waveUp = waveBlend > waveMA

int longThresh  = input.int(6, "Impulse long score >=", minval = 1, maxval = 10, group = "8. Signals")
bool showImpulseLong = input.bool(true, "Impulse long (IN)", group = "8. Signals")
bool showExhaustion = input.bool(false, "Exhaustion diamonds", group = "8. Signals")
bool showStEnv = input.bool(false, "ST env X", group = "8. Signals")

bool gated = not confirmOnClose or barstate.isconfirmed
bool trigLong  = ta.crossover(cci, 0) or ta.crossover(hullFast, hullSlow) or stFlipUp or ta.crossover(macdPct, 0)
bool chopBlock = blockChop and regime == "CHOP"
bool volGate = not requireVol or volOk
bool htfGateL = not requireHtf or htfVote >= 0
bool impulseLongRaw = gated and not chopBlock and volGate and htfGateL and score >= longThresh and trigLong and close > open
bool fadeLong  = gated and cci > cciExt and ta.crossunder(cci, cciExt) and vSlow == 1
bool fadeShort = gated and cci < -cciExt and ta.crossover(cci, -cciExt) and vSlow == -1
bool stEnvUp = gated and ta.crossunder(st3, st1) and stMajorityUp and close > open
bool stEnvDn = gated and ta.crossover(st3, st1) and stMajorityDn and close < open

// Cipher A overlay tells (VuManChu open-source). Warnings always print. Long marks respect INV.
// EMA ribbon in A is 5/11/15/18/21/24/28/34. WT in A is 9/13/3 (B is 9/12/3).
// Yellow X / blood diamond are CAUTION, not shorts. STLong recipe below is unchanged.
bool showCipherA = input.bool(true, "Cipher A marks", group = "12. Cipher A")
bool showCaRibbon = input.bool(false, "Cipher A 8-EMA ribbon", group = "12. Cipher A")
bool showCaLong = input.bool(true, "Blue triangle / long EMA", group = "12. Cipher A")
bool showCaWarn = input.bool(true, "Red X / diamond / yellow X / blood", group = "12. Cipher A")
float caEma1 = ta.ema(close, 5)
float caEma2 = ta.ema(close, 11)
float caEma3 = ta.ema(close, 15)
float caEma4 = ta.ema(close, 18)
float caEma5 = ta.ema(close, 21)
float caEma6 = ta.ema(close, 24)
float caEma7 = ta.ema(close, 28)
float caEma8 = ta.ema(close, 34)
float caEsa = ta.ema(hlc3, 9)
float caDe = ta.ema(math.abs(hlc3 - caEsa), 9)
float caCi = caDe == 0 ? 0.0 : (hlc3 - caEsa) / (0.015 * caDe)
float caWt1 = ta.ema(caCi, 13)
float caWt2 = ta.sma(caWt1, 3)
float caRsi = ta.rsi(close, 14)
float caRange = high - low
float caMf = ta.sma((caRange == 0 ? 0.0 : (close - open) / caRange) * 150.0, 60)
bool caRibbonUp = caEma2 > caEma8
bool caLongEma = ta.crossover(caEma2, caEma8)
bool caRedCross = ta.crossunder(caEma1, caEma2)
bool caBlue = ta.crossover(caEma2, caEma3)
bool caRedDiamond = ta.crossunder(caWt1, caWt2)
bool caYellowX = caRedDiamond and caWt2 < 45.0 and caWt2 > -80.0 and caRsi < 30.0 and caRsi > 15.0 and caMf < -5.0
bool caBlood = caRedDiamond and caRedCross

// SUPERLONG - exact W2T recipe (lime "L").
// Original: emabuy3 and hmaaboveema5 and hmaaboveema and hmaaboveema2
//           and ta.crossover(macd, 0.0002) and ccibuy and temabuy and temabuy2
// temabuy2 is TEMA50 > TEMA100 (NOT 34>50 - that swap is why HYPE daily went quiet).
bool showSuperLong = input.bool(true, "Show SUPERLONG", group = "9. W2T recipes")
bool emabuy3 = MA3 > MA6
bool hmaaboveema5 = hull80 > MA6
bool hmaaboveema = hull2 > MA6
bool hmaaboveema2 = hull80 > MA3
bool ccibuy = cci > 0
bool temabuy = tema1 > tema2
bool temabuy2 = tema3 > tema4
bool SUPERLONG_RAW = emabuy3 and hmaaboveema5 and hmaaboveema and hmaaboveema2 and ta.crossover(macd, 0) and ccibuy and temabuy and temabuy2

// STLong - original size.small purple L.
// Original: STBUY and CCI cross 0 and TFccibuy and hmabuy and HMA>ST1/2/3 and BullCandle
bool showSTLong = input.bool(true, "Show STLong", group = "9. W2T recipes")
bool hmabuy = hullFast > hullSlow
bool hmasupertrendbuy = hullFast > st3 and hullFast > st1 and hullFast > st2
bool STLong_RAW = stMajorityUp and ta.crossover(cci, 0) and hmabuy and hmasupertrendbuy and close > open

// Invalidation: regular bearish divergence on the Wave blend (price HH + blend LH).
// Prints INV at the SAME pivot Wave labels BEAR (offset left by pivot-right).
// Sticky: kills K / STLong / SUPERLONG / IN until a regular bull div or a CLOSE above the pivot high.
bool killOnBearDiv = input.bool(true, "Kill longs on Wave bear div", group = "11. Invalidation")
int invLeft = input.int(5, "Div pivot left", minval = 1, group = "11. Invalidation")
int invRight = input.int(5, "Div pivot right", minval = 1, group = "11. Invalidation")
int invMax = input.int(60, "Div max lookback", minval = 5, group = "11. Invalidation")
int invMin = input.int(5, "Div min lookback", minval = 1, group = "11. Invalidation")
bool showInv = input.bool(true, "Mark Wave BEAR as INV on Tape", group = "11. Invalidation")
int stampBars = input.int(20, "L-INV lookback (bars)", minval = 1, maxval = 100, group = "11. Invalidation")

_inRangeInv(bool cond) =>
    int bars = ta.barssince(cond)
    not na(bars) and bars >= invMin and bars <= invMax

bool plW = not na(ta.pivotlow(waveBlend, invLeft, invRight))
bool phW = not na(ta.pivothigh(waveBlend, invLeft, invRight))
bool wLH = waveBlend[invRight] < ta.valuewhen(phW, waveBlend[invRight], 1) and _inRangeInv(phW[1])
bool wHL = waveBlend[invRight] > ta.valuewhen(plW, waveBlend[invRight], 1) and _inRangeInv(plW[1])
bool pxHH = high[invRight] > ta.valuewhen(phW, high[invRight], 1)
bool pxLL = low[invRight] < ta.valuewhen(plW, low[invRight], 1)
bool bearDiv = pxHH and wLH and phW
bool bullDiv = pxLL and wHL and plW

var bool bearDivActive = false
var float bearDivCap = na
if bearDiv
    bearDivActive := true
    bearDivCap := high[invRight]
else if bullDiv
    bearDivActive := false
    bearDivCap := na
else if bearDivActive and not na(bearDivCap) and close > bearDivCap
    bearDivActive := false
    bearDivCap := na

bool invKill = killOnBearDiv and bearDivActive
bool impulseLong = impulseLongRaw and not invKill
bool SUPERLONG = SUPERLONG_RAW and not invKill
bool STLong = STLong_RAW and not invKill

// Matrix winner: CCI cross 0 while the tape is still bullish.
bool showKairos = input.bool(true, "Kairos long (K)", group = "10. Combined")
bool kRequireFast = input.bool(true, "Require fast cloud up", group = "10. Combined")
bool kRequireMid = input.bool(true, "Require mid cloud up", group = "10. Combined")
bool kRequirePx = input.bool(true, "Require close > slow EMA", group = "10. Combined")
bool kRequireWave = input.bool(false, "Require Wave blend teal", group = "10. Combined")
bool kRequireST = input.bool(false, "Require SuperTrend majority up", group = "10. Combined")
bool kairosRaw = ta.crossover(cci, 0) and close > open and (not kRequireFast or vFast == 1) and (not kRequireMid or vMid == 1) and (not kRequirePx or close > MA6) and (not kRequireWave or waveUp) and (not kRequireST or stMajorityUp)
bool kairosLong = kairosRaw and not invKill
bool anyLongRaw = impulseLongRaw or SUPERLONG_RAW or STLong_RAW or kairosRaw
bool skippedLong = showInv and invKill and anyLongRaw

plot(showVwap ? vwapVal : na, "VWAP", color = color.new(cCopper, 30), linewidth = 1)

pMA1 = plot(MA1, "MA1", color = showLines ? color.new(vFast > 0 ? cFastUp : cFastDn, 10) : na, linewidth = 1)
pMA2 = plot(MA2, "MA2", color = showLines ? color.new(vFast > 0 ? cFastUp : cFastDn, 25) : na, linewidth = 1)
pMA3 = plot(MA3, "MA3", color = showLines ? color.new(vMid  > 0 ? cMidUp  : cMidDn, 5)  : na, linewidth = 1)
pMA4 = plot(MA4, "MA4", color = showLines ? color.new(vMid  > 0 ? cMidUp  : cMidDn, 20) : na, linewidth = 1)
pMA5 = plot(MA5, "MA5", color = showLines ? color.new(vSlow > 0 ? cSlowUp : cSlowDn, 30) : na, linewidth = 1)
pMA6 = plot(MA6, "MA6", color = showLines or showSlow ? color.new(vSlow > 0 ? cSlowUp : cSlowDn, 0) : na, linewidth = 2)
fill(pMA1, pMA2, showClouds ? color.new(vFast > 0 ? cFastUp : cFastDn, 68) : na, title = "Fast cloud")
fill(pMA3, pMA4, showClouds ? color.new(vMid  > 0 ? cMidUp  : cMidDn,  64) : na, title = "Mid cloud")
fill(pMA5, pMA6, showClouds ? color.new(vSlow > 0 ? cSlowUp : cSlowDn, 72) : na, title = "Slow cloud")

pCa1 = plot(showCaRibbon ? caEma1 : na, "CA EMA5", color = color.new(caRibbonUp ? #1573d4 : cRose, 30), linewidth = 1)
pCa2 = plot(showCaRibbon ? caEma2 : na, "CA EMA11", color = color.new(caRibbonUp ? #3096ff : cRose, 30), linewidth = 1)
plot(showCaRibbon ? caEma3 : na, "CA EMA15", color = color.new(caRibbonUp ? #57abff : cRose, 50), linewidth = 1)
plot(showCaRibbon ? caEma4 : na, "CA EMA18", color = color.new(caRibbonUp ? #85c2ff : cRose, 55), linewidth = 1)
plot(showCaRibbon ? caEma5 : na, "CA EMA21", color = color.new(caRibbonUp ? #9bcdff : cRose, 60), linewidth = 1)
plot(showCaRibbon ? caEma6 : na, "CA EMA24", color = color.new(caRibbonUp ? #b3d9ff : cRose, 65), linewidth = 1)
plot(showCaRibbon ? caEma7 : na, "CA EMA28", color = color.new(caRibbonUp ? #c9e5ff : cRose, 70), linewidth = 1)
pCa8 = plot(showCaRibbon ? caEma8 : na, "CA EMA34", color = color.new(caRibbonUp ? #dfecfb : cRose, 20), linewidth = 2)
fill(pCa1, pCa2, showCaRibbon ? color.new(#1573d4, 88) : na, title = "CA fast fill")
fill(pCa2, pCa8, showCaRibbon ? color.new(caRibbonUp ? #3096ff : cRose, 90) : na, title = "CA ribbon")

bodyMid = plot((open + close) / 2.0, display = display.none, editable = false)
up3 = plot(dir3 < 0 ? st3 : na, "ST3 up", color = showST ? color.new(cSlate, 40) : na, style = plot.style_linebr, linewidth = 2)
dn3 = plot(dir3 > 0 ? st3 : na, "ST3 dn", color = showST ? color.new(cRose, 40) : na, style = plot.style_linebr, linewidth = 2)
fill(bodyMid, up3, showST ? color.new(cTeal, 88) : na, title = "ST up")
fill(bodyMid, dn3, showST ? color.new(cRose, 88) : na, title = "ST dn")

barcolor(cci > cciSoft ? color.new(cTeal, 55) : cci < -cciSoft ? color.new(cRose, 55) : na)

plotshape(showImpulseLong and impulseLong,  title = "Impulse Long",  style = shape.triangleup,   location = location.belowbar, color = cTeal,   size = size.small, text = "IN", textcolor = color.white)
plotshape(showExhaustion and fadeLong,     title = "Exhaustion L",  style = shape.diamond,      location = location.abovebar, color = cCopper, size = size.tiny,  text = "EX")
plotshape(showExhaustion and fadeShort,    title = "Exhaustion S",  style = shape.diamond,      location = location.belowbar, color = cCopper, size = size.tiny,  text = "EX")
plotshape(showStEnv and stEnvUp,      title = "ST env up",     style = shape.xcross,       location = location.belowbar, color = cSlate,  size = size.tiny)
plotshape(showStEnv and stEnvDn,      title = "ST env down",   style = shape.xcross,       location = location.abovebar, color = cRose,   size = size.tiny)
plotshape(showSuperLong and SUPERLONG, title = "SUPERLONG", style = shape.triangleup, location = location.belowbar, color = #3aff54, size = size.tiny, text = "L", textcolor = color.white)
plotshape(showSTLong and STLong, title = "STLong", style = shape.triangleup, location = location.belowbar, color = #e597ff, size = size.small, text = "L")
plotshape(showKairos and kairosLong, title = "Kairos long", style = shape.triangleup, location = location.belowbar, color = cCopper, size = size.normal, text = "K", textcolor = color.white)
plotshape(showCipherA and showCaLong and caBlue and not invKill, title = "CA blue triangle", style = shape.triangleup, location = location.belowbar, color = #0064ff, size = size.tiny)
plotshape(showCipherA and showCaLong and caLongEma and not invKill, title = "CA long EMA", style = shape.circle, location = location.belowbar, color = #3fff00, size = size.tiny)
plotshape(showCipherA and showCaWarn and caRedCross, title = "CA red X", style = shape.xcross, location = location.abovebar, color = #ff2d6a, size = size.tiny)
plotshape(showCipherA and showCaWarn and caRedDiamond and not caBlood and not caYellowX, title = "CA red diamond", style = shape.diamond, location = location.abovebar, color = #ff2d6a, size = size.tiny)
plotshape(showCipherA and showCaWarn and caYellowX, title = "CA yellow X", style = shape.xcross, location = location.abovebar, color = #ffe500, size = size.small)
plotshape(showCipherA and showCaWarn and caBlood, title = "CA blood diamond", style = shape.diamond, location = location.abovebar, color = #ff003c, size = size.small)
// INV sits on the SAME candle Wave labels BEAR (pivot, 5 bars back).
plotshape(showInv and bearDiv, title = "Wave BEAR invalidation", style = shape.xcross, location = location.abovebar, color = cRose, size = size.small, text = "INV", textcolor = color.white, offset = -invRight)
// L-INV on a live long that tried to print after the BEAR is already active.
plotshape(skippedLong, title = "L-INV skipped", style = shape.xcross, location = location.abovebar, color = cRose, size = size.small, text = "L-INV")

// After Wave BEAR confirms, stamp any Tape L / IN / K in the last stampBars as invalidated.
// Pine cannot un-print the original triangle; this tags it after the fact.
if showInv and bearDiv
    label.new(bar_index[invRight], high[invRight], "INV", style = label.style_label_down, color = cRose, textcolor = color.white, size = size.small)
    for i = 0 to stampBars
        bool wasL  = SUPERLONG_RAW[i] or STLong_RAW[i]
        bool wasIN = impulseLongRaw[i]
        bool wasK  = kairosRaw[i]
        if wasL or wasIN or wasK
            string tag = wasL ? "L-INV" : wasK ? "K-INV" : "IN-INV"
            label.new(bar_index[i], low[i], tag, xloc = xloc.bar_index, style = label.style_label_up, color = cRose, textcolor = color.white, size = size.small)

var table dash = table.new(position.top_right, 2, 8, bgcolor = color.new(#141821, 18), border_width = 1, frame_width = 1, frame_color = color.new(cCopper, 55))

if showDash and barstate.islast
    color regimeCol = regime == "TREND" ? cTeal : regime == "CHOP" ? cRose : cCopper
    color scoreCol = score >= longThresh ? cTeal : score <= -6 ? cRose : cInk
    color htfCol = htfBull ? cTeal : htfBear ? cRose : cInk
    table.cell(dash, 0, 0, "KAIROS TAPE", text_color = cCopper, text_size = size.small)
    table.cell(dash, 1, 0, profile, text_color = cCopper, text_size = size.small)
    table.cell(dash, 0, 1, "Regime", text_color = cInk, text_size = size.small)
    table.cell(dash, 1, 1, regime, text_color = regimeCol, text_size = size.small)
    table.cell(dash, 0, 2, "Score", text_color = cInk, text_size = size.small)
    table.cell(dash, 1, 2, str.tostring(score) + " / 10", text_color = scoreCol, text_size = size.small)
    table.cell(dash, 0, 3, "HTF " + htf, text_color = cInk, text_size = size.small)
    table.cell(dash, 1, 3, htfBull ? "BULL" : htfBear ? "BEAR" : "NEUTRAL", text_color = htfCol, text_size = size.small)
    table.cell(dash, 0, 4, "Ribbon", text_color = cInk, text_size = size.small)
    table.cell(dash, 1, 4, vSlow > 0 ? "SLOW UP" : "SLOW DN", text_color = vSlow > 0 ? cTeal : cRose, text_size = size.small)
    table.cell(dash, 0, 5, "ST stack", text_color = cInk, text_size = size.small)
    table.cell(dash, 1, 5, str.tostring(stBullCount) + "/3 up", text_color = stMajorityUp ? cTeal : cRose, text_size = size.small)
    table.cell(dash, 0, 6, "Rel vol", text_color = cInk, text_size = size.small)
    table.cell(dash, 1, 6, str.tostring(relVol, "#.00") + "x", text_color = volOk ? cTeal : cRose, text_size = size.small)
    table.cell(dash, 0, 7, "Wave INV", text_color = cInk, text_size = size.small)
    table.cell(dash, 1, 7, bearDivActive ? "LIVE - skip" : "clear", text_color = bearDivActive ? cRose : cTeal, text_size = size.small)

alertcondition(impulseLong,  "Kairos Tape Impulse Long",  "Impulse long")
alertcondition(fadeLong,     "Kairos Tape Exhaustion Long",  "CCI rolling over")
alertcondition(stEnvUp,      "Kairos Tape ST env up",   "SuperTrend constructive")
alertcondition(largeSwing,   "Kairos Tape large swing", "Confirmed large pivot")
alertcondition(SUPERLONG,    "Kairos Tape SUPERLONG", "W2T SuperLong: MACD cross 0 + TEMA50>100 + HMA/EMA stack")
alertcondition(STLong,       "Kairos Tape STLong",    "W2T STLong: CCI cross 0 + HMA above SuperTrend stack")
alertcondition(kairosLong,   "Kairos combined long",  "CCI cross 0 + bullish fast/mid cloud + price > slow EMA")
alertcondition(bearDiv,      "Kairos Wave bear div INV", "Regular bearish divergence - Tape longs killed until bull div or close above pivot high")
alertcondition(skippedLong,  "Kairos long skipped", "Tape long skipped because Wave bear div is live")
alertcondition(caBlue and not invKill, "Cipher A blue triangle", "EMA 11 crossed EMA 15")
alertcondition(caLongEma and not invKill, "Cipher A long EMA", "EMA 11 crossed EMA 34")
alertcondition(caYellowX, "Cipher A yellow X", "WT down-cross into RSI/MF washout - caution, not a long")
alertcondition(caBlood, "Cipher A blood diamond", "WT down-cross + EMA 5/11 death cross - flatten")

if impulseLong
    alert("KAIROS TAPE impulse LONG | score " + str.tostring(score) + " | " + regime, alert.freq_once_per_bar_close)
if SUPERLONG
    alert("KAIROS TAPE SUPERLONG | MACD cross 0 | TEMA50>100 | HMA above slow tape", alert.freq_once_per_bar_close)
if STLong
    alert("KAIROS TAPE STLong | CCI cross 0 | HMA above ST stack", alert.freq_once_per_bar_close)
if kairosLong
    alert("KAIROS LONG | CCI cross 0 | fast/mid cloud UP | px > slow EMA | score " + str.tostring(score), alert.freq_once_per_bar_close)
if bearDiv
    alert("KAIROS INV | Wave BEAR div confirmed - skip Tape longs until bull div or close above pivot high", alert.freq_once_per_bar_close)
if skippedLong
    alert("KAIROS SKIPPED | Wave bear div live - long trigger ignored", alert.freq_once_per_bar_close)
