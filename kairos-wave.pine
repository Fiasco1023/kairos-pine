// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Kairos Wave — pane oscillator successor to "CCI + RSI Div + Stochastic RSI".
// Pair with Kairos Tape on the price pane. Do not merge the two scripts.
// Pine Script v6 · LazyBear WaveTrend (public) · standard MFI · confirmed pivots.

//@version=6
indicator("Kairos Wave", shorttitle = "KRS Wave", overlay = false, format = format.price, max_labels_count = 100, max_lines_count = 80)

// Unified scale is WaveTrend-native (~−100 … +100).
// CCI is divided by 2.5 so ±200 lands on ±80.
// RSI / Stoch are centered at 50 then scaled: (x − 50) * 1.6.
// This replaces the original RSI * 4 − 200 hack with a documented mapping.

color cTeal = #3aa88a
color cRose = #c45c4a
color cCopper = #c9a227
color cAmber = #e0a15a
color cBlue = #4c7ad9
color cViolet = #8b6bb5
color cInk = #d8d4c8

// ─────────────────────────────────────────────────────────────────────────────
// Visibility
// ─────────────────────────────────────────────────────────────────────────────
bool showWt   = input.bool(true, "WaveTrend", group = "Show", inline = "s")
bool showCci  = input.bool(true, "CCI", group = "Show", inline = "s")
bool showMf   = input.bool(true, "Money flow", group = "Show", inline = "s")
bool showRsi  = input.bool(true, "RSI", group = "Show", inline = "s2")
bool showStoch = input.bool(true, "Stoch RSI", group = "Show", inline = "s2")
bool showVwap = input.bool(true, "VWAP distance", group = "Show", inline = "s2")
bool showDots = input.bool(true, "Cross dots", group = "Show")
bool showPrime = input.bool(true, "Prime marks", group = "Show")
bool showDivWt = input.bool(true, "WT divergences", group = "Show")
bool showDivCci = input.bool(false, "CCI divergences", group = "Show")
bool showDivRsi = input.bool(true, "RSI divergences (original)", group = "Show")
bool showMeter = input.bool(true, "Confluence meter (right)", group = "Show")

bool confirmOnClose = input.bool(true, "Confirm dots on bar close", group = "Show", tooltip = "On: dots print after the close. Off: forming-bar preview.")

// ─────────────────────────────────────────────────────────────────────────────
// WaveTrend — LazyBear public formula (the actual Cipher-B ancestor)
// esa = EMA(hlc3, n1)
// d   = EMA(|hlc3 − esa|, n1)
// ci  = (hlc3 − esa) / (0.015 * d)     // CCI-style 0.015 normalizer
// wt1 = EMA(ci, n2)
// wt2 = SMA(wt1, 4)
// ─────────────────────────────────────────────────────────────────────────────
int n1 = input.int(10, "Channel length n1", minval = 1, group = "WaveTrend")
int n2 = input.int(21, "Average length n2", minval = 1, group = "WaveTrend")
int nSmooth = input.int(4, "WT2 smooth", minval = 1, group = "WaveTrend")
float ob1 = input.float(60, "Overbought 1", group = "WaveTrend", inline = "ob")
float ob2 = input.float(53, "Overbought 2", group = "WaveTrend", inline = "ob")
float os1 = input.float(-60, "Oversold 1", group = "WaveTrend", inline = "os")
float os2 = input.float(-53, "Oversold 2", group = "WaveTrend", inline = "os")

float ap = hlc3
float esa = ta.ema(ap, n1)
float de = ta.ema(math.abs(ap - esa), n1)
float ci = de == 0 ? 0.0 : (ap - esa) / (0.015 * de)
float wt1 = ta.ema(ci, n2)
float wt2 = ta.sma(wt1, nSmooth)

// ─────────────────────────────────────────────────────────────────────────────
// CCI — original unique edge, rescaled onto the WT axis
// ─────────────────────────────────────────────────────────────────────────────
int cciLen = input.int(50, "CCI length", minval = 1, group = "CCI")
srcCci = input.source(hlc3, "CCI source", group = "CCI")
float cciRaw = ta.cci(srcCci, cciLen)
float cci = cciRaw * 0.4
int cciMaLen1 = input.int(12, "CCI MA fast", minval = 1, group = "CCI")
int cciMaLen2 = input.int(26, "CCI MA slow", minval = 1, group = "CCI")
string cciMaType = input.string("SMA", "CCI MA method", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = "CCI")
f_ma(float src, int len, string typ) =>
    switch typ
        "EMA" => ta.ema(src, len)
        "SMMA (RMA)" => ta.rma(src, len)
        "WMA" => ta.wma(src, len)
        "VWMA" => ta.vwma(src, len)
        => ta.sma(src, len)
float cciMa1 = f_ma(cci, cciMaLen1, cciMaType)
float cciMa2 = f_ma(cci, cciMaLen2, cciMaType)

// ─────────────────────────────────────────────────────────────────────────────
// Money flow — standard MFI, plotted as a zero-centered area.
// Optional Heikin Ashi source is a public smoothing trick (HA typical price).
// No offset: VMC's well-known "MFI sits behind the waves" bug was an offset.
// Fast MFI (14) is a line; slow MFI (60) is the area.
// ─────────────────────────────────────────────────────────────────────────────
bool mfUseHA = input.bool(false, "MFI source = Heikin Ashi", group = "Money flow", tooltip = "Smooths flow. Public HA typical-price technique, not a vendor formula.")
int mfFastLen = input.int(14, "Fast MFI", minval = 1, group = "Money flow")
int mfSlowLen = input.int(60, "Slow MFI", minval = 1, group = "Money flow")
float mfScale = input.float(1.2, "Area scale", minval = 0.1, step = 0.1, group = "Money flow")

haClose = (open + high + low + close) / 4.0
var float haOpen = na
haOpen := na(haOpen[1]) ? (open + close) / 2.0 : (nz(haOpen[1]) + nz(haClose[1])) / 2.0
haHigh = math.max(high, math.max(haOpen, haClose))
haLow = math.min(low, math.min(haOpen, haClose))
float haTypical = (haHigh + haLow + haClose) / 3.0
float mfSrc = mfUseHA ? haTypical : hlc3
float mfiFast = ta.mfi(mfSrc, mfFastLen)
float mfiSlow = ta.mfi(mfSrc, mfSlowLen)
float mfArea = (mfiSlow - 50.0) * mfScale
float mfFastLine = (mfiFast - 50.0) * mfScale
bool mfGreen = mfArea >= 0
bool mfRising = mfArea > mfArea[1]

// ─────────────────────────────────────────────────────────────────────────────
// RSI + Stochastic RSI (kept from original, remapped onto unified scale)
// ─────────────────────────────────────────────────────────────────────────────
int rsiLen = input.int(14, "RSI length", minval = 1, group = "RSI")
srcRsi = input.source(close, "RSI source", group = "RSI")
float rsiRaw = ta.rsi(srcRsi, rsiLen)
float rsi = (rsiRaw - 50.0) * 1.6
int rsiMaLen = input.int(14, "RSI MA", minval = 1, group = "RSI")
string rsiMaType = input.string("SMA", "RSI MA type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = "RSI")
float rsiMa = f_ma(rsi, rsiMaLen, rsiMaType)

int kLen = input.int(3, "Stoch K", minval = 1, group = "Stochastic RSI")
int dLen = input.int(3, "Stoch D", minval = 1, group = "Stochastic RSI")
int stochRsiLen = input.int(14, "Stoch RSI length", minval = 1, group = "Stochastic RSI")
int stochLen = input.int(14, "Stochastic length", minval = 1, group = "Stochastic RSI")
float rsiForStoch = ta.rsi(close, stochRsiLen)
float kRaw = ta.sma(ta.stoch(rsiForStoch, rsiForStoch, rsiForStoch, stochLen), kLen)
float dRaw = ta.sma(kRaw, dLen)
float k = (kRaw - 50.0) * 1.6
float d = (dRaw - 50.0) * 1.6

// ─────────────────────────────────────────────────────────────────────────────
// VWAP distance oscillator — (close − session VWAP) / ATR
// Public concept; used by many Cipher-B-class tools as a yellow wave.
// We plot it as a thin copper area, not a vendor-identical "yellow wave".
// ─────────────────────────────────────────────────────────────────────────────
float vwapVal = ta.vwap(hlc3)
float atr = ta.atr(14)
float vwapOsc = atr == 0 ? 0.0 : ((close - vwapVal) / atr) * 10.0
float vwapOscClamped = math.max(-40.0, math.min(40.0, vwapOsc))

// ─────────────────────────────────────────────────────────────────────────────
// HTF WaveTrend bias (last closed HTF bar)
// ─────────────────────────────────────────────────────────────────────────────
string htf = input.timeframe("60", "HTF", group = "Higher timeframe")
bool htfStrict = input.bool(true, "Last closed HTF bar", group = "Higher timeframe")
bool htfBg = input.bool(true, "Tint background with HTF bias", group = "Higher timeframe")

f_htfWtLive() =>
    esaH = ta.ema(hlc3, n1)
    deH = ta.ema(math.abs(hlc3 - esaH), n1)
    ciH = deH == 0 ? 0.0 : (hlc3 - esaH) / (0.015 * deH)
    ta.ema(ciH, n2)

f_htfWtClosed() =>
    esaH = ta.ema(hlc3, n1)
    deH = ta.ema(math.abs(hlc3 - esaH), n1)
    ciH = deH == 0 ? 0.0 : (hlc3 - esaH) / (0.015 * deH)
    wtH = ta.ema(ciH, n2)
    wtH[1]

float htfWtLive = request.security(syminfo.tickerid, htf, f_htfWtLive(), barmerge.gaps_off, barmerge.lookahead_off)
float htfWtClosed = request.security(syminfo.tickerid, htf, f_htfWtClosed(), barmerge.gaps_off, barmerge.lookahead_on)
float htfWave = htfStrict ? htfWtClosed : htfWtLive
bool htfBull = htfWave > 0
bool htfBear = htfWave < 0

// ─────────────────────────────────────────────────────────────────────────────
// Divergences — pivot confirmation (lbR bars of lag, no lookahead)
// Regular: price LL + osc HL (bull) / price HH + osc LH (bear)
// Hidden:  price HL + osc LL (bull) / price LH + osc HH (bear)
// ─────────────────────────────────────────────────────────────────────────────
int lbL = input.int(5, "Pivot left", minval = 1, group = "Divergences")
int lbR = input.int(5, "Pivot right", minval = 1, group = "Divergences")
int rangeUpper = input.int(60, "Max lookback", minval = 5, group = "Divergences")
int rangeLower = input.int(5, "Min lookback", minval = 1, group = "Divergences")
bool plotBull = input.bool(true, "Regular bull", group = "Divergences")
bool plotBear = input.bool(true, "Regular bear", group = "Divergences")
bool plotHidBull = input.bool(false, "Hidden bull", group = "Divergences")
bool plotHidBear = input.bool(false, "Hidden bear", group = "Divergences")

_inRange(bool cond) =>
    int bars = ta.barssince(cond)
    not na(bars) and bars >= rangeLower and bars <= rangeUpper

f_div(float osc) =>
    bool pl = not na(ta.pivotlow(osc, lbL, lbR))
    bool ph = not na(ta.pivothigh(osc, lbL, lbR))
    bool oscHL = osc[lbR] > ta.valuewhen(pl, osc[lbR], 1) and _inRange(pl[1])
    bool oscLL = osc[lbR] < ta.valuewhen(pl, osc[lbR], 1) and _inRange(pl[1])
    bool oscLH = osc[lbR] < ta.valuewhen(ph, osc[lbR], 1) and _inRange(ph[1])
    bool oscHH = osc[lbR] > ta.valuewhen(ph, osc[lbR], 1) and _inRange(ph[1])
    bool priceLL = low[lbR] < ta.valuewhen(pl, low[lbR], 1)
    bool priceHL = low[lbR] > ta.valuewhen(pl, low[lbR], 1)
    bool priceHH = high[lbR] > ta.valuewhen(ph, high[lbR], 1)
    bool priceLH = high[lbR] < ta.valuewhen(ph, high[lbR], 1)
    bool bull = priceLL and oscHL and pl
    bool hidBull = priceHL and oscLL and pl
    bool bear = priceHH and oscLH and ph
    bool hidBear = priceLH and oscHH and ph
    [pl, ph, bull, hidBull, bear, hidBear]

[plWt, phWt, bullWt, hidBullWt, bearWt, hidBearWt] = f_div(wt1)
[plCci, phCci, bullCci, hidBullCci, bearCci, hidBearCci] = f_div(cci)
[plRsi, phRsi, bullRsi, hidBullRsi, bearRsi, hidBearRsi] = f_div(rsi)

color noneCol = color.new(color.white, 100)

// ─────────────────────────────────────────────────────────────────────────────
// Dots — WT1/WT2 cross, quality-tiered (not a vendor gold-circle clone)
// Prime  : cross at extreme + money-flow agreement + RSI confirm + HTF not opposed
// Standard: cross at extreme
// Fade   : any other cross (off by default — noise)
// ─────────────────────────────────────────────────────────────────────────────
bool showFadeDots = input.bool(false, "Show mid-zone crosses", group = "Dots")
bool wtUp = ta.crossover(wt1, wt2)
bool wtDn = ta.crossunder(wt1, wt2)
bool gated = not confirmOnClose or barstate.isconfirmed

bool extremeOs = wt1 <= os1
bool extremeOb = wt1 >= ob1
bool rsiOs = rsiRaw < 45
bool rsiOb = rsiRaw > 55

bool primeLong = gated and wtUp and extremeOs and mfGreen and rsiOs and not htfBear
bool primeShort = gated and wtDn and extremeOb and not mfGreen and rsiOb and not htfBull
bool stdLong = gated and wtUp and (wt1 < 0) and not primeLong
bool stdShort = gated and wtDn and (wt1 > 0) and not primeShort
bool fadeLong = gated and showFadeDots and wtUp and wt1 >= 0
bool fadeShort = gated and showFadeDots and wtDn and wt1 <= 0

// ─────────────────────────────────────────────────────────────────────────────
// Confluence meter −100 … +100 (transparent, additive)
// ─────────────────────────────────────────────────────────────────────────────
int mWt = wt1 > wt2 ? 20 : -20
int mLvl = wt1 > ob1 ? -10 : wt1 < os1 ? 10 : wt1 > 0 ? 8 : -8
int mMf = mfGreen ? 15 : -15
int mMfSlope = mfRising ? 8 : -8
int mCci = cci > 0 ? 12 : -12
int mRsi = rsiRaw > 50 ? 10 : -10
int mSto = kRaw > dRaw ? 8 : -8
int mVwap = vwapOsc > 0 ? 7 : -7
int mHtf = htfBull ? 10 : htfBear ? -10 : 0
int meter = mWt + mLvl + mMf + mMfSlope + mCci + mRsi + mSto + mVwap + mHtf
float meterClamped = math.max(-100.0, math.min(100.0, meter))

// ─────────────────────────────────────────────────────────────────────────────
// Plots
// ─────────────────────────────────────────────────────────────────────────────
hline(0, "Zero", color = color.new(#787B86, 40), linestyle = hline.style_dotted)
hOb1 = hline(ob1, "OB1", color = color.new(cRose, 30), linestyle = hline.style_dashed)
hOs1 = hline(os1, "OS1", color = color.new(cTeal, 30), linestyle = hline.style_dashed)
hline(ob2, "OB2", color = color.new(cRose, 70), linestyle = hline.style_dotted)
hline(os2, "OS2", color = color.new(cTeal, 70), linestyle = hline.style_dotted)
hObCci = hline(80, "CCI ±200 (scaled)", color = color.new(#e67878, 50), linestyle = hline.style_dashed)
hOsCci = hline(-80, "CCI −200 (scaled)", color = color.new(#81e678, 50), linestyle = hline.style_dashed)
hStoHi = hline((80.0 - 50.0) * 1.6, "Stoch 80", color = color.new(#787B86, 50))
hStoLo = hline((20.0 - 50.0) * 1.6, "Stoch 20", color = color.new(#787B86, 50))
fill(hStoHi, hStoLo, color = color.new(#3aa88a, 92), title = "Stoch band")

plot(showMf ? mfArea : na, "Slow MFI area", color = mfGreen ? color.new(cTeal, 72) : color.new(cRose, 72), style = plot.style_area)
plot(showMf ? mfFastLine : na, "Fast MFI", color = color.new(cInk, 50), linewidth = 1)
plot(showVwap ? vwapOscClamped : na, "VWAP distance", color = color.new(cCopper, 55), style = plot.style_area)
plot(showCci ? cci : na, "CCI (scaled)", color = color.new(#ff4fd0, 0), linewidth = 1)
plot(showCci ? cciMa1 : na, "CCI MA fast", color = color.new(#f37f20, 0), display = display.data_window)
plot(showCci ? cciMa2 : na, "CCI MA slow", color = color.new(#5b29b8, 0), display = display.data_window)
plot(showRsi ? rsi : na, "RSI (scaled)", color = color.new(#00d8e0, 0), linewidth = 2)
plot(showRsi ? rsiMa : na, "RSI MA", color = color.new(#e6d35a, 0), linewidth = 1)
plot(showStoch ? k : na, "Stoch K", color = color.new(cBlue, 0))
plot(showStoch ? d : na, "Stoch D", color = color.new(#FF6D00, 0))

plot(showWt ? wt1 : na, "WT1", color = color.new(cAmber, 0), linewidth = 2)
plot(showWt ? wt2 : na, "WT2", color = color.new(cViolet, 0), linewidth = 1)

bgcolor(htfBg ? (htfBull ? color.new(cTeal, 94) : htfBear ? color.new(cRose, 94) : na) : na, title = "HTF bias")

// Divergence traces (offset = −lbR is the confirmed pivot, not lookahead)
plot(showDivWt and plWt ? wt1[lbR] : na, offset = -lbR, title = "WT bull pivot", color = (plotBull and bullWt) ? cTeal : (plotHidBull and hidBullWt) ? color.new(cTeal, 70) : noneCol, linewidth = 2)
plot(showDivWt and phWt ? wt1[lbR] : na, offset = -lbR, title = "WT bear pivot", color = (plotBear and bearWt) ? cRose : (plotHidBear and hidBearWt) ? color.new(cRose, 70) : noneCol, linewidth = 2)
plot(showDivCci and plCci ? cci[lbR] : na, offset = -lbR, title = "CCI bull pivot", color = (plotBull and bullCci) ? cTeal : noneCol, linewidth = 1)
plot(showDivCci and phCci ? cci[lbR] : na, offset = -lbR, title = "CCI bear pivot", color = (plotBear and bearCci) ? cRose : noneCol, linewidth = 1)
plot(showDivRsi and plRsi ? rsi[lbR] : na, offset = -lbR, title = "RSI bull pivot", color = (plotBull and bullRsi) ? cTeal : (plotHidBull and hidBullRsi) ? color.new(cTeal, 70) : noneCol, linewidth = 2)
plot(showDivRsi and phRsi ? rsi[lbR] : na, offset = -lbR, title = "RSI bear pivot", color = (plotBear and bearRsi) ? cRose : (plotHidBear and hidBearRsi) ? color.new(cRose, 70) : noneCol, linewidth = 2)

plotshape(showPrime and primeLong ? wt1 : na, title = "Prime long", style = shape.diamond, location = location.absolute, color = color.new(cCopper, 0), size = size.small)
plotshape(showPrime and primeShort ? wt1 : na, title = "Prime short", style = shape.diamond, location = location.absolute, color = color.new(cRose, 0), size = size.small)
plotshape(showDots and stdLong ? wt1 : na, title = "Standard long", style = shape.circle, location = location.absolute, color = color.new(cTeal, 0), size = size.tiny)
plotshape(showDots and stdShort ? wt1 : na, title = "Standard short", style = shape.circle, location = location.absolute, color = color.new(cRose, 0), size = size.tiny)
plotshape(showDots and fadeLong ? wt1 : na, title = "Fade long", style = shape.circle, location = location.absolute, color = color.new(cTeal, 65), size = size.tiny)
plotshape(showDots and fadeShort ? wt1 : na, title = "Fade short", style = shape.circle, location = location.absolute, color = color.new(cRose, 65), size = size.tiny)

plot(showMeter ? meterClamped : na, "Confluence meter", color = meterClamped >= 0 ? color.new(cTeal, 40) : color.new(cRose, 40), style = plot.style_histogram)

// Tiny last-bar table
var table dash = table.new(position.top_right, 2, 6, bgcolor = color.new(#141821, 20), border_width = 1, border_color = color.new(cCopper, 50), frame_width = 1, frame_color = color.new(cCopper, 50))
if barstate.islast
    table.cell(dash, 0, 0, "KAIROS WAVE", text_color = cCopper, text_size = size.small)
    table.cell(dash, 1, 0, str.tostring(meterClamped, "#"), text_color = meterClamped >= 0 ? cTeal : cRose, text_size = size.small)
    table.cell(dash, 0, 1, "WT", text_color = cInk, text_size = size.small)
    table.cell(dash, 1, 1, str.tostring(wt1, "#.0"), text_color = wt1 > wt2 ? cTeal : cRose, text_size = size.small)
    table.cell(dash, 0, 2, "CCI", text_color = cInk, text_size = size.small)
    table.cell(dash, 1, 2, str.tostring(cciRaw, "#.0"), text_color = cciRaw > 0 ? cTeal : cRose, text_size = size.small)
    table.cell(dash, 0, 3, "MFI", text_color = cInk, text_size = size.small)
    table.cell(dash, 1, 3, str.tostring(mfiSlow, "#.0"), text_color = mfGreen ? cTeal : cRose, text_size = size.small)
    table.cell(dash, 0, 4, "RSI", text_color = cInk, text_size = size.small)
    table.cell(dash, 1, 4, str.tostring(rsiRaw, "#.0"), text_color = rsiRaw >= 50 ? cTeal : cRose, text_size = size.small)
    table.cell(dash, 0, 5, "HTF", text_color = cInk, text_size = size.small)
    table.cell(dash, 1, 5, htfBull ? "BULL" : htfBear ? "BEAR" : "FLAT", text_color = htfBull ? cTeal : htfBear ? cRose : cInk, text_size = size.small)

// ─────────────────────────────────────────────────────────────────────────────
// Alerts
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(primeLong, "Kairos Wave Prime Long", "Prime long: WT cross up at oversold + MFI green + RSI confirm + HTF not opposed")
alertcondition(primeShort, "Kairos Wave Prime Short", "Prime short: WT cross down at overbought + MFI red + RSI confirm + HTF not opposed")
alertcondition(stdLong, "Kairos Wave WT cross up", "WaveTrend cross up below zero")
alertcondition(stdShort, "Kairos Wave WT cross down", "WaveTrend cross down above zero")
alertcondition(bullWt, "WT regular bull divergence", "Regular bullish divergence on WaveTrend (confirmed pivot)")
alertcondition(bearWt, "WT regular bear divergence", "Regular bearish divergence on WaveTrend (confirmed pivot)")
alertcondition(bullRsi, "RSI regular bull divergence", "Regular bullish divergence on RSI (original detector)")
alertcondition(bearRsi, "RSI regular bear divergence", "Regular bearish divergence on RSI (original detector)")
alertcondition(ta.crossover(cciRaw, 0), "CCI cross above 0", "CCI crossed above zero")
alertcondition(ta.crossunder(cciRaw, 0), "CCI cross below 0", "CCI crossed below zero")
alertcondition(ta.crossover(mfiSlow, 50), "MFI flipped in", "Slow MFI crossed above 50")
alertcondition(ta.crossunder(mfiSlow, 50), "MFI flipped out", "Slow MFI crossed below 50")

if primeLong
    alert("KAIROS WAVE prime LONG | WT " + str.tostring(wt1, "#.0") + " | MFI " + str.tostring(mfiSlow, "#.0"), alert.freq_once_per_bar_close)
if primeShort
    alert("KAIROS WAVE prime SHORT | WT " + str.tostring(wt1, "#.0") + " | MFI " + str.tostring(mfiSlow, "#.0"), alert.freq_once_per_bar_close)
