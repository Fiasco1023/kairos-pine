// Kairos Wave v6 — ONE composite line. Pair with Kairos Tape. Do not merge.
// Legs (RSI, CCI, Stoch, WaveTrend, MFI, VWAP) are scaled to +/-200 and averaged.
// They are ingredients, not extra plots. Divergences and dots fire on the blend.
//@version=6
indicator("Kairos Wave", shorttitle = "KRS Wave", overlay = false, format = format.price, max_labels_count = 100, max_lines_count = 50)

color cTeal   = #3aa88a
color cRose   = #c45c4a
color cCopper = #c9a227
color cInk    = #d8d4c8

bool showComp = input.bool(true, "Composite", group = "Show")
bool showMA   = input.bool(true, "Composite MA", group = "Show")
bool showDots = input.bool(true, "Signal dots", group = "Show")
bool showDiv  = input.bool(true, "Divergences", group = "Show")
bool showRaw  = input.bool(false, "Ghost legs (debug)", group = "Show")
bool confirmOnClose = input.bool(true, "Confirm on bar close", group = "Show")

bool useRsi  = input.bool(true, "RSI", group = "Legs in the blend", inline = "a")
bool useCci  = input.bool(true, "CCI", group = "Legs in the blend", inline = "a")
bool useSto  = input.bool(true, "Stoch", group = "Legs in the blend", inline = "a")
bool useWt   = input.bool(true, "WaveTrend", group = "Legs in the blend", inline = "b")
bool useMfi  = input.bool(true, "MFI", group = "Legs in the blend", inline = "b")
bool useVwap = input.bool(true, "VWAP dist", group = "Legs in the blend", inline = "b")

int rsiLen = input.int(14, "RSI length", minval = 1, group = "Lengths")
srcRsi = input.source(close, "RSI source", group = "Lengths")
int cciLen = input.int(50, "CCI length", minval = 1, group = "Lengths")
srcCci = input.source(hlc3, "CCI source", group = "Lengths")
int stochLen = input.int(14, "Stoch length", minval = 1, group = "Lengths")
int smoothK = input.int(3, "K", minval = 1, group = "Lengths", inline = "k")
int smoothD = input.int(3, "D", minval = 1, group = "Lengths", inline = "k")
int n1 = input.int(10, "WT n1", minval = 1, group = "Lengths", inline = "w")
int n2 = input.int(21, "WT n2", minval = 1, group = "Lengths", inline = "w")
int mfLen = input.int(60, "MFI length", minval = 1, group = "Lengths")
string maType = input.string("EMA", "MA type", options = ["EMA", "SMA"], group = "Lengths")
int maLen = input.int(14, "MA length", minval = 1, group = "Lengths")
float zone = input.float(100.0, "Signal zone (+/-)", minval = 20, group = "Lengths")

int lbL = input.int(5, "Pivot left", minval = 1, group = "Divergences")
int lbR = input.int(5, "Pivot right", minval = 1, group = "Divergences")
int rangeUpper = input.int(60, "Max lookback", minval = 5, group = "Divergences")
int rangeLower = input.int(5, "Min lookback", minval = 1, group = "Divergences")
bool plotBull = input.bool(true, "Regular bull", group = "Divergences")
bool plotBear = input.bool(true, "Regular bear", group = "Divergences")
bool plotHidBull = input.bool(false, "Hidden bull", group = "Divergences")
bool plotHidBear = input.bool(false, "Hidden bear", group = "Divergences")

string htf = input.timeframe("60", "HTF", group = "HTF")
bool requireHtf = input.bool(false, "Prime requires HTF agreement", group = "HTF")

f_clamp(float x) =>
    math.max(-200.0, math.min(200.0, x))

// Each leg onto the same +/-200 rail so no single series dominates.
float rsi = ta.rsi(srcRsi, rsiLen)
float rsiN = f_clamp(rsi * 4.0 - 200.0)

float cciN = f_clamp(ta.cci(srcCci, cciLen))

float kRaw = ta.sma(ta.stoch(close, high, low, stochLen), smoothK)
float dRaw = ta.sma(kRaw, smoothD)
float stoN = f_clamp(kRaw * 4.0 - 200.0)

float esa = ta.ema(hlc3, n1)
float de = ta.ema(math.abs(hlc3 - esa), n1)
float ci = de == 0 ? 0.0 : (hlc3 - esa) / (0.015 * de)
float wt1 = ta.ema(ci, n2)
float wtN = f_clamp(wt1 * 2.0)

float mfi = ta.mfi(hlc3, mfLen)
float mfiN = f_clamp((mfi - 50.0) * 4.0)

float vwapVal = ta.vwap(hlc3)
float atr = ta.atr(14)
float vwapN = f_clamp(atr == 0 ? 0.0 : ((close - vwapVal) / atr) * 20.0)

float acc = (useRsi ? rsiN : 0.0) + (useCci ? cciN : 0.0) + (useSto ? stoN : 0.0) + (useWt ? wtN : 0.0) + (useMfi ? mfiN : 0.0) + (useVwap ? vwapN : 0.0)
int nLegs = (useRsi ? 1 : 0) + (useCci ? 1 : 0) + (useSto ? 1 : 0) + (useWt ? 1 : 0) + (useMfi ? 1 : 0) + (useVwap ? 1 : 0)
float composite = nLegs == 0 ? 0.0 : acc / nLegs
float compositeMA = maType == "SMA" ? ta.sma(composite, maLen) : ta.ema(composite, maLen)

int nOs = (useRsi and rsiN <= -zone ? 1 : 0) + (useCci and cciN <= -zone ? 1 : 0) + (useSto and stoN <= -zone ? 1 : 0) + (useWt and wtN <= -zone ? 1 : 0) + (useMfi and mfiN <= -zone ? 1 : 0) + (useVwap and vwapN <= -zone ? 1 : 0)
int nOb = (useRsi and rsiN >= zone ? 1 : 0) + (useCci and cciN >= zone ? 1 : 0) + (useSto and stoN >= zone ? 1 : 0) + (useWt and wtN >= zone ? 1 : 0) + (useMfi and mfiN >= zone ? 1 : 0) + (useVwap and vwapN >= zone ? 1 : 0)
int needAgree = math.max(2, nLegs - 2)

float htfClose = request.security(syminfo.tickerid, htf, close[1], barmerge.gaps_off, barmerge.lookahead_on)
float htfEma = request.security(syminfo.tickerid, htf, ta.ema(close, 50)[1], barmerge.gaps_off, barmerge.lookahead_on)
bool htfBull = htfClose > htfEma
bool htfBear = htfClose < htfEma

bool gated = not confirmOnClose or barstate.isconfirmed
bool crossUp = ta.crossover(composite, compositeMA)
bool crossDn = ta.crossunder(composite, compositeMA)
bool inOs = composite <= -zone
bool inOb = composite >= zone

bool sigLong  = gated and crossUp and inOs
bool sigShort = gated and crossDn and inOb
bool primeLong  = sigLong  and nOs >= needAgree and (not requireHtf or not htfBear)
bool primeShort = sigShort and nOb >= needAgree and (not requireHtf or not htfBull)

_inRange(bool cond) =>
    int bars = ta.barssince(cond)
    not na(bars) and bars >= rangeLower and bars <= rangeUpper

bool plFound = not na(ta.pivotlow(composite, lbL, lbR))
bool phFound = not na(ta.pivothigh(composite, lbL, lbR))
bool compHL = composite[lbR] > ta.valuewhen(plFound, composite[lbR], 1) and _inRange(plFound[1])
bool compLL = composite[lbR] < ta.valuewhen(plFound, composite[lbR], 1) and _inRange(plFound[1])
bool compLH = composite[lbR] < ta.valuewhen(phFound, composite[lbR], 1) and _inRange(phFound[1])
bool compHH = composite[lbR] > ta.valuewhen(phFound, composite[lbR], 1) and _inRange(phFound[1])
bool priceLL = low[lbR]  < ta.valuewhen(plFound, low[lbR], 1)
bool priceHL = low[lbR]  > ta.valuewhen(plFound, low[lbR], 1)
bool priceHH = high[lbR] > ta.valuewhen(phFound, high[lbR], 1)
bool priceLH = high[lbR] < ta.valuewhen(phFound, high[lbR], 1)
bool bullCond = plotBull and showDiv and priceLL and compHL and plFound
bool hidBull  = plotHidBull and showDiv and priceHL and compLL and plFound
bool bearCond = plotBear and showDiv and priceHH and compLH and phFound
bool hidBear  = plotHidBear and showDiv and priceLH and compHH and phFound

hline(0, "Zero", color = color.new(#787B86, 40), linestyle = hline.style_dotted)
hUp = hline(zone, "OB", color = color.new(cRose, 40), linestyle = hline.style_dashed)
hDn = hline(-zone, "OS", color = color.new(cTeal, 40), linestyle = hline.style_dashed)
fill(hUp, hDn, color = color.new(#3aa88a, 94), title = "Neutral zone")

plot(showRaw and useRsi  ? rsiN  : na, "RSI", color = color.new(#00d8e0, 78))
plot(showRaw and useCci  ? cciN  : na, "CCI", color = color.new(#ff4fd0, 78))
plot(showRaw and useSto  ? stoN  : na, "Stoch", color = color.new(#4c7ad9, 78))
plot(showRaw and useWt   ? wtN   : na, "WT", color = color.new(cCopper, 78))
plot(showRaw and useMfi  ? mfiN  : na, "MFI", color = color.new(#8b6bb5, 78))
plot(showRaw and useVwap ? vwapN : na, "VWAP", color = color.new(#e0a15a, 78))

color compCol = composite > compositeMA ? cTeal : cRose
plot(showComp ? composite : na, "Composite", color = compCol, linewidth = 3)
plot(showMA ? compositeMA : na, "Composite MA", color = cCopper, linewidth = 2)

color noneCol = color.new(color.white, 100)
plot(showDiv and plFound ? composite[lbR] : na, offset = -lbR, title = "Bull pivot", color = bullCond ? cTeal : hidBull ? color.new(cTeal, 65) : noneCol, linewidth = 2)
plot(showDiv and phFound ? composite[lbR] : na, offset = -lbR, title = "Bear pivot", color = bearCond ? cRose : hidBear ? color.new(cRose, 65) : noneCol, linewidth = 2)

plotshape(showDots and primeLong ? composite : na, title = "Prime long", style = shape.diamond, location = location.absolute, color = cCopper, size = size.small)
plotshape(showDots and primeShort ? composite : na, title = "Prime short", style = shape.diamond, location = location.absolute, color = cRose, size = size.small)
plotshape(showDots and sigLong and not primeLong ? composite : na, title = "Long", style = shape.circle, location = location.absolute, color = cTeal, size = size.tiny)
plotshape(showDots and sigShort and not primeShort ? composite : na, title = "Short", style = shape.circle, location = location.absolute, color = cRose, size = size.tiny)

if bullCond
    label.new(bar_index[lbR], composite[lbR], "BULL", style = label.style_label_up, color = cTeal, textcolor = color.black, size = size.small)
if hidBull
    label.new(bar_index[lbR], composite[lbR], "H Bull", style = label.style_label_up, color = color.new(cTeal, 40), textcolor = color.black, size = size.small)
if bearCond
    label.new(bar_index[lbR], composite[lbR], "BEAR", style = label.style_label_down, color = cRose, textcolor = color.white, size = size.small)
if hidBear
    label.new(bar_index[lbR], composite[lbR], "H Bear", style = label.style_label_down, color = color.new(cRose, 40), textcolor = color.white, size = size.small)

alertcondition(primeLong, "Wave Prime Long", "Blend cross up in OS + most legs oversold")
alertcondition(primeShort, "Wave Prime Short", "Blend cross down in OB + most legs overbought")
alertcondition(sigLong, "Wave Long", "Composite crossed above MA in oversold zone")
alertcondition(sigShort, "Wave Short", "Composite crossed below MA in overbought zone")
alertcondition(bullCond, "Wave regular bull div", "Regular bullish divergence on composite")
alertcondition(bearCond, "Wave regular bear div", "Regular bearish divergence on composite")

if primeLong
    alert("KAIROS WAVE prime LONG | blend " + str.tostring(composite, "#.0") + " | legs OS " + str.tostring(nOs) + "/" + str.tostring(nLegs), alert.freq_once_per_bar_close)
if primeShort
    alert("KAIROS WAVE prime SHORT | blend " + str.tostring(composite, "#.0") + " | legs OB " + str.tostring(nOb) + "/" + str.tostring(nLegs), alert.freq_once_per_bar_close)
