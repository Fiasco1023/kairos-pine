// Kairos Wave v6 - pane oscillator. Pair with Kairos Tape. Do not merge.
// Composite on: one blend (default CCI + WaveTrend VMC 9/12/3).
// Composite off: each checked oscillator plots as itself, with its own MA and divergences.
// Green dots = VMC Cipher B buy (WT1 x WT2 while WT2 <= -53). No short dots.
//@version=6
indicator("Kairos Wave", shorttitle = "Kairos Wave", overlay = false, format = format.price, max_labels_count = 100, max_lines_count = 50)

color cTeal   = #3aa88a
color cRose   = #c45c4a
color cCopper = #c9a227
color cInk    = #d8d4c8

bool showMA   = input.bool(true, "MA", group = "Show", inline = "s")
bool showDots = input.bool(true, "OS dots", group = "Show", inline = "s")
bool showCipherDots = input.bool(true, "Cipher dots", group = "Show", inline = "s2")
bool showMfArea = input.bool(true, "Money flow", group = "Show", inline = "s2")
bool showDiv  = input.bool(true, "Div lines", group = "Show", inline = "s3")
bool showDivLabels = input.bool(false, "Labels", group = "Show", inline = "s3")
bool showRaw  = input.bool(false, "Ghost legs", group = "Show")
bool showBlendTag = input.bool(true, "Blend tag", group = "Show", tooltip = "Shows which oscillators are actually live. Pine cannot re-tick the Custom boxes when you change Preset.")
bool confirmOnClose = input.bool(true, "Confirm on close", group = "Show")

bool showComp = input.bool(true, "Composite", group = "Blend", tooltip = "On: one blended line. Off: each live oscillator plots as itself (own MA + divergences).")
string blendPreset = input.string("Research (CCI+WT)", "Preset", options = ["Research (CCI+WT)", "HYPE (RSI+CCI+Stoch+MFI)", "Full 5", "Custom"], group = "Blend", tooltip = "Named presets pick the blend. Custom uses the boxes. TradingView cannot auto-check those boxes when you change this dropdown.")
bool inRsi  = input.bool(false, "Custom: RSI", group = "Blend", inline = "a", tooltip = "Only used when Preset = Custom.")
bool inCci  = input.bool(true,  "CCI", group = "Blend", inline = "a", tooltip = "Only used when Preset = Custom.")
bool inSto  = input.bool(false, "Stoch", group = "Blend", inline = "a", tooltip = "Only used when Preset = Custom.")
bool inWt   = input.bool(true,  "WT", group = "Blend", inline = "b", tooltip = "Only used when Preset = Custom.")
bool inMfi  = input.bool(false, "MFI", group = "Blend", inline = "b", tooltip = "Only used when Preset = Custom.")
bool inVwap = input.bool(false, "VWAP", group = "Blend", inline = "b", tooltip = "Only used when Preset = Custom.")

bool isHype = blendPreset == "HYPE (RSI+CCI+Stoch+MFI)"
bool isFull = blendPreset == "Full 5"
bool isCust = blendPreset == "Custom"
bool useRsi  = isHype or isFull or (isCust and inRsi)
bool useCci  = not isCust or inCci
bool useSto  = isHype or isFull or (isCust and inSto)
bool useWt   = blendPreset == "Research (CCI+WT)" or isFull or (isCust and inWt)
bool useMfi  = isHype or isFull or (isCust and inMfi)
bool useVwap = isCust and inVwap

int rsiLen = input.int(14, "RSI length", minval = 1, group = "Lengths")
srcRsi = input.source(close, "RSI source", group = "Lengths")
int cciLen = input.int(50, "CCI length", minval = 1, group = "Lengths")
srcCci = input.source(hlc3, "CCI source", group = "Lengths")
int stochLen = input.int(14, "Stoch length", minval = 1, group = "Lengths")
int smoothK = input.int(3, "K", minval = 1, group = "Lengths", inline = "k")
int smoothD = input.int(3, "D", minval = 1, group = "Lengths", inline = "k")
int n1 = input.int(9, "WT channel (VMC 9)", minval = 1, group = "Lengths", inline = "w")
int n2 = input.int(12, "WT average (VMC 12)", minval = 1, group = "Lengths", inline = "w")
int n3 = input.int(3, "WT MA (VMC 3)", minval = 1, group = "Lengths", inline = "w")
int mfLen = input.int(60, "MFI length", minval = 1, group = "Lengths")
float mfMult = input.float(175.0, "MF area multiplier", minval = 1, group = "Lengths")
string maType = input.string("EMA", "MA type", options = ["EMA", "SMA"], group = "Lengths")
int maLen = input.int(14, "MA length", minval = 1, group = "Lengths")
float zone = input.float(100.0, "Signal zone (+/-)", minval = 20, group = "Lengths")

int lbL = input.int(5, "Pivot left", minval = 1, group = "Divergences")
int lbR = input.int(5, "Pivot right", minval = 1, group = "Divergences")
int rangeUpper = input.int(60, "Max lookback", minval = 5, group = "Divergences")
int rangeLower = input.int(5, "Min lookback", minval = 1, group = "Divergences")
bool plotBull = input.bool(true, "Regular bull", group = "Divergences")
bool plotBear = input.bool(true, "Regular bear", group = "Divergences")
bool plotHidBull = input.bool(false, "Hidden bull", group = "Divergences")
bool plotHidBear = input.bool(false, "Hidden bear", group = "Divergences")

string htf = input.timeframe("", "HTF (blank = chart)", group = "HTF")
bool requireHtf = input.bool(false, "Prime requires HTF agreement", group = "HTF")

float rsi = ta.rsi(srcRsi, rsiLen)
float cci = ta.cci(srcCci, cciLen)
float kRaw = ta.sma(ta.stoch(close, high, low, stochLen), smoothK)
float dRaw = ta.sma(kRaw, smoothD)
float esa = ta.ema(hlc3, n1)
float de = ta.ema(math.abs(hlc3 - esa), n1)
float ci = de == 0 ? 0.0 : (hlc3 - esa) / (0.015 * de)
float wt1 = ta.ema(ci, n2)
float wt2 = ta.sma(wt1, n3)
float mfi = ta.mfi(hlc3, mfLen)
float hlRange = high - low
float mfArea = ta.sma((hlRange == 0 ? 0.0 : (close - open) / hlRange) * mfMult, mfLen) - 2.5
float mfAreaN = mfArea
float vwapVal = ta.vwap(hlc3)
float atr = ta.atr(14)
float vwapDist = atr == 0 ? 0.0 : (close - vwapVal) / atr * 50.0

float rsiB = (rsi - 50.0) * 2.0
float stoB = (kRaw - 50.0) * 2.0
float mfiB = (mfi - 50.0) * 2.0

bool rsiOn = useRsi and not na(rsi)
bool cciOn = useCci and not na(cci)
bool stoOn = useSto and not na(kRaw)
bool wtOn  = useWt and not na(wt1)
bool mfiOn = useMfi and not na(mfi)
bool vwapOn = useVwap and not na(vwapDist)
int nLegs = (rsiOn ? 1 : 0) + (cciOn ? 1 : 0) + (stoOn ? 1 : 0) + (wtOn ? 1 : 0) + (mfiOn ? 1 : 0) + (vwapOn ? 1 : 0)
bool pctOnly = nLegs > 0 and not cciOn and not wtOn and not vwapOn
bool zeroOnly = nLegs > 0 and not rsiOn and not stoOn and not mfiOn
float accPct = (rsiOn ? rsi : 0.0) + (stoOn ? kRaw : 0.0) + (mfiOn ? mfi : 0.0)
float accB = (rsiOn ? rsiB : 0.0) + (cciOn ? cci : 0.0) + (stoOn ? stoB : 0.0) + (wtOn ? wt1 : 0.0) + (mfiOn ? mfiB : 0.0) + (vwapOn ? vwapDist : 0.0)
float native = rsiOn ? rsi : cciOn ? cci : stoOn ? kRaw : wtOn ? wt1 : mfiOn ? mfi : vwapDist
float composite = nLegs == 0 ? 0.0 : nLegs == 1 ? native : pctOnly ? accPct / nLegs : accB / nLegs
float compositeMA = maType == "SMA" ? ta.sma(composite, maLen) : ta.ema(composite, maLen)

bool pctScale = pctOnly
float zeroY = pctScale ? 50.0 : 0.0
float obY = pctScale ? (rsiOn ? 70.0 : 80.0) : nLegs == 1 and wtOn ? 60.0 : nLegs == 1 and cciOn ? 100.0 : zeroOnly and cciOn ? 100.0 : zeroOnly ? 60.0 : 60.0
float osY = pctScale ? (rsiOn ? 30.0 : 20.0) : nLegs == 1 and wtOn ? -60.0 : nLegs == 1 and cciOn ? -100.0 : zeroOnly and cciOn ? -100.0 : zeroOnly ? -60.0 : -60.0

int nOs = (rsiOn and rsi <= 30.0 ? 1 : 0) + (cciOn and cci <= -100.0 ? 1 : 0) + (stoOn and kRaw <= 20.0 ? 1 : 0) + (wtOn and wt1 <= -60.0 ? 1 : 0) + (mfiOn and mfi <= 20.0 ? 1 : 0) + (vwapOn and vwapDist <= -zone ? 1 : 0)
int needAgree = nLegs <= 1 ? 1 : nLegs > 4 ? nLegs - 2 : 2

float htfClose = request.security(syminfo.tickerid, htf, close[1], barmerge.gaps_off, barmerge.lookahead_on)
float htfEma = request.security(syminfo.tickerid, htf, ta.ema(close, 50)[1], barmerge.gaps_off, barmerge.lookahead_on)
bool htfBear = htfClose < htfEma

bool gated = not confirmOnClose or barstate.isconfirmed
bool crossUp = ta.crossover(composite, compositeMA)
bool inOs = composite <= osY
bool sigLong  = gated and crossUp and inOs
bool primeLong  = sigLong and nOs >= needAgree and (not requireHtf or not htfBear)
bool cipherGreen = gated and ta.crossover(wt1, wt2) and wt2 <= -53.0

_inRange(bool cond) =>
    int bars = ta.barssince(cond)
    not na(bars) and bars >= rangeLower and bars <= rangeUpper

f_legDiv(float src) =>
    bool plFound = not na(ta.pivotlow(src, lbL, lbR))
    bool phFound = not na(ta.pivothigh(src, lbL, lbR))
    bool srcHL = src[lbR] > ta.valuewhen(plFound, src[lbR], 1) and _inRange(plFound[1])
    bool srcLL = src[lbR] < ta.valuewhen(plFound, src[lbR], 1) and _inRange(plFound[1])
    bool srcLH = src[lbR] < ta.valuewhen(phFound, src[lbR], 1) and _inRange(phFound[1])
    bool srcHH = src[lbR] > ta.valuewhen(phFound, src[lbR], 1) and _inRange(phFound[1])
    bool pxLL = low[lbR]  < ta.valuewhen(plFound, low[lbR], 1)
    bool pxHL = low[lbR]  > ta.valuewhen(plFound, low[lbR], 1)
    bool pxHH = high[lbR] > ta.valuewhen(phFound, high[lbR], 1)
    bool pxLH = high[lbR] < ta.valuewhen(phFound, high[lbR], 1)
    bool bull = plotBull and showDiv and pxLL and srcHL and plFound
    bool hBull = plotHidBull and showDiv and pxHL and srcLL and plFound
    bool bear = plotBear and showDiv and pxHH and srcLH and phFound
    bool hBear = plotHidBear and showDiv and pxLH and srcHH and phFound
    [plFound, phFound, bull, hBull, bear, hBear]

f_ma(float src) =>
    maType == "SMA" ? ta.sma(src, maLen) : ta.ema(src, maLen)

[plFound, phFound, bullCond, hidBull, bearCond, hidBear] = f_legDiv(composite)
[rsiPL, rsiPH, rsiBull, rsiHB, rsiBear, rsiHBe] = f_legDiv(rsi)
[cciPL, cciPH, cciBull, cciHB, cciBear, cciHBe] = f_legDiv(cci)
[stoPL, stoPH, stoBull, stoHB, stoBear, stoHBe] = f_legDiv(kRaw)
[wtPL, wtPH, wtBull, wtHB, wtBear, wtHBe] = f_legDiv(wt1)
[mfiPL, mfiPH, mfiBull, mfiHB, mfiBear, mfiHBe] = f_legDiv(mfi)

bool legsMode = not showComp
color noneCol = color.new(color.white, 100)
color rsiCol = #00d8e0
color cciCol = #ff4fd0
color stoCol = #4c7ad9
color wtCol  = cCopper
color mfiCol = #8b6bb5
color vwCol  = #e0a15a

pZero = plot(zeroY, "Zero", color = color.new(#787B86, 40), linewidth = 1)
pOb = plot(obY, "OB", color = color.new(cRose, 40), linewidth = 1)
pOs = plot(osY, "OS", color = color.new(cTeal, 40), linewidth = 1)
fill(pOb, pOs, color.new(#3aa88a, 94), title = "Signal zone")
plot(cciOn and not pctScale ? 200.0 : na, "CCI OB 200", color = color.new(cRose, 55), linewidth = 1)
plot(cciOn and not pctScale ? -200.0 : na, "CCI OS 200", color = color.new(cTeal, 55), linewidth = 1)

plot(showMfArea ? mfAreaN : na, "Money flow area", color = mfAreaN >= 0 ? color.new(#3fff00, 55) : color.new(#ff3535, 55), style = plot.style_histogram, linewidth = 2)

plot(showComp ? composite : na, "Composite", color = composite > compositeMA ? cTeal : cRose, linewidth = 3)
plot(showComp and showMA ? compositeMA : na, "Composite MA", color = cCopper, linewidth = 2)

plot(legsMode and useRsi ? rsi : showRaw and useRsi ? rsi : na, "RSI", color = legsMode ? rsiCol : color.new(rsiCol, 78), linewidth = legsMode ? 2 : 1)
plot(legsMode and useRsi and showMA ? f_ma(rsi) : na, "RSI MA", color = color.new(rsiCol, 40))
plot(legsMode and useCci ? cci : showRaw and useCci ? cci : na, "CCI", color = legsMode ? cciCol : color.new(cciCol, 78), linewidth = legsMode ? 2 : 1)
plot(legsMode and useCci and showMA ? f_ma(cci) : na, "CCI MA", color = color.new(cciCol, 40))
plot(legsMode and useSto ? kRaw : showRaw and useSto ? kRaw : na, "Stoch K", color = legsMode ? stoCol : color.new(stoCol, 78), linewidth = legsMode ? 2 : 1)
plot(legsMode and useSto ? dRaw : na, "Stoch D", color = color.new(stoCol, 35))
plot(legsMode and useWt ? wt1 : showRaw and useWt ? wt1 : na, "WT1", color = legsMode ? wtCol : color.new(wtCol, 78), linewidth = legsMode ? 2 : 1)
plot(legsMode and useWt ? wt2 : na, "WT2", color = color.new(wtCol, 35))
plot(legsMode and useMfi ? mfi : showRaw and useMfi ? mfi : na, "MFI", color = legsMode ? mfiCol : color.new(mfiCol, 78), linewidth = legsMode ? 2 : 1)
plot(legsMode and useMfi and showMA ? f_ma(mfi) : na, "MFI MA", color = color.new(mfiCol, 40))
plot(legsMode and useVwap ? vwapDist : showRaw and useVwap ? vwapDist : na, "VWAP dist", color = legsMode ? vwCol : color.new(vwCol, 78), linewidth = legsMode ? 2 : 1)

plot(showComp and showDiv and plFound ? composite[lbR] : na, offset = -lbR, title = "Bull pivot", color = bullCond ? cTeal : hidBull ? color.new(cTeal, 65) : noneCol, linewidth = 2)
plot(showComp and showDiv and phFound ? composite[lbR] : na, offset = -lbR, title = "Bear pivot", color = bearCond ? cRose : hidBear ? color.new(cRose, 65) : noneCol, linewidth = 2)
plot(legsMode and useRsi and showDiv and rsiPL ? rsi[lbR] : na, offset = -lbR, title = "RSI bull div", color = rsiBull ? cTeal : rsiHB ? color.new(cTeal, 65) : noneCol)
plot(legsMode and useRsi and showDiv and rsiPH ? rsi[lbR] : na, offset = -lbR, title = "RSI bear div", color = rsiBear ? cRose : rsiHBe ? color.new(cRose, 65) : noneCol)
plot(legsMode and useCci and showDiv and cciPL ? cci[lbR] : na, offset = -lbR, title = "CCI bull div", color = cciBull ? cTeal : cciHB ? color.new(cTeal, 65) : noneCol)
plot(legsMode and useCci and showDiv and cciPH ? cci[lbR] : na, offset = -lbR, title = "CCI bear div", color = cciBear ? cRose : cciHBe ? color.new(cRose, 65) : noneCol)
plot(legsMode and useSto and showDiv and stoPL ? kRaw[lbR] : na, offset = -lbR, title = "Stoch bull div", color = stoBull ? cTeal : stoHB ? color.new(cTeal, 65) : noneCol)
plot(legsMode and useSto and showDiv and stoPH ? kRaw[lbR] : na, offset = -lbR, title = "Stoch bear div", color = stoBear ? cRose : stoHBe ? color.new(cRose, 65) : noneCol)
plot(legsMode and useWt and showDiv and wtPL ? wt1[lbR] : na, offset = -lbR, title = "WT bull div", color = wtBull ? cTeal : wtHB ? color.new(cTeal, 65) : noneCol)
plot(legsMode and useWt and showDiv and wtPH ? wt1[lbR] : na, offset = -lbR, title = "WT bear div", color = wtBear ? cRose : wtHBe ? color.new(cRose, 65) : noneCol)
plot(legsMode and useMfi and showDiv and mfiPL ? mfi[lbR] : na, offset = -lbR, title = "MFI bull div", color = mfiBull ? cTeal : mfiHB ? color.new(cTeal, 65) : noneCol)
plot(legsMode and useMfi and showDiv and mfiPH ? mfi[lbR] : na, offset = -lbR, title = "MFI bear div", color = mfiBear ? cRose : mfiHBe ? color.new(cRose, 65) : noneCol)

plotshape(showComp and showDots and primeLong ? composite : na, title = "Prime long watch", style = shape.diamond, location = location.absolute, color = cCopper, size = size.small)
plotshape(showComp and showDots and sigLong and not primeLong ? composite : na, title = "Long watch", style = shape.circle, location = location.absolute, color = cTeal, size = size.tiny)
plotshape(showCipherDots and cipherGreen, title = "Cipher green dot", style = shape.circle, location = location.bottom, color = #3fff00, size = size.small)

f_divLabel(bool bull, bool hBull, bool bear, bool hBear, float y) =>
    if showDivLabels and bull
        label.new(bar_index[lbR], y, "BULL", style = label.style_label_up, color = cTeal, textcolor = color.black, size = size.tiny)
    if showDivLabels and hBull
        label.new(bar_index[lbR], y, "H Bull", style = label.style_label_up, color = color.new(cTeal, 40), textcolor = color.black, size = size.tiny)
    if showDivLabels and bear
        label.new(bar_index[lbR], y, "BEAR", style = label.style_label_down, color = cRose, textcolor = color.white, size = size.tiny)
    if showDivLabels and hBear
        label.new(bar_index[lbR], y, "H Bear", style = label.style_label_down, color = color.new(cRose, 40), textcolor = color.white, size = size.tiny)

if showComp
    f_divLabel(bullCond, hidBull, bearCond, hidBear, composite[lbR])
else
    if useRsi
        f_divLabel(rsiBull, rsiHB, rsiBear, rsiHBe, rsi[lbR])
    if useCci
        f_divLabel(cciBull, cciHB, cciBear, cciHBe, cci[lbR])
    if useSto
        f_divLabel(stoBull, stoHB, stoBear, stoHBe, kRaw[lbR])
    if useWt
        f_divLabel(wtBull, wtHB, wtBear, wtHBe, wt1[lbR])
    if useMfi
        f_divLabel(mfiBull, mfiHB, mfiBear, mfiHBe, mfi[lbR])

alertcondition(primeLong, "Wave Prime Long", "Blend cross up in OS + most legs oversold")
alertcondition(sigLong, "Wave Long watch", "Composite crossed above MA in oversold zone")
alertcondition(cipherGreen, "Wave Cipher green dot", "WT1 crossed WT2 in oversold (VMC green dot)")
alertcondition(bullCond, "Wave regular bull div", "Regular bullish divergence on composite")
alertcondition(bearCond, "Wave regular bear div - Tape invalidation", "Regular bearish divergence. Skip Tape longs until it fails.")
alertcondition(cciBear, "Wave CCI bear div", "Regular bearish divergence on CCI")
alertcondition(rsiBear, "Wave RSI bear div", "Regular bearish divergence on RSI")

if primeLong
    alert("KAIROS WAVE prime LONG watch | blend " + str.tostring(composite, "#.0") + " | legs OS " + str.tostring(nOs) + "/" + str.tostring(nLegs), alert.freq_once_per_bar_close)
if bearCond
    alert("KAIROS WAVE BEAR DIV | Tape longs invalidated until bull div or pivot-high break", alert.freq_once_per_bar_close)

var table blendTag = na
if barstate.islast and showBlendTag
    string live = (useRsi ? "RSI  " : "") + (useCci ? "CCI  " : "") + (useSto ? "Stoch  " : "") + (useWt ? "WT  " : "") + (useMfi ? "MFI  " : "") + (useVwap ? "VWAP" : "")
    if na(blendTag)
        blendTag := table.new(position.top_right, 1, 2, bgcolor = color.new(#141821, 12), border_width = 1, frame_width = 1, frame_color = color.new(cCopper, 55))
    table.cell(blendTag, 0, 0, isCust ? "CUSTOM" : blendPreset, text_color = cCopper, text_size = size.tiny)
    table.cell(blendTag, 0, 1, str.replace_all(live, "  ", " "), text_color = cInk, text_size = size.small)
else if not na(blendTag)
    table.delete(blendTag)
    blendTag := na
